{
  "name": "@customaise/mcp",
  "version": "3.2.5",
  "description": "MCP server and CLI bridging AI coding agents (Cursor, Claude Code, Codex, Windsurf, Kiro, Antigravity, Claude Desktop) to the Customaise Chrome extension. 19 tools: UserScripts, AgentScripts, WebMCP calls with HITL consent, visual DOM targeting, tab control. Drive it over stdio from an IDE, or as a `customaise` command from a shell.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "customaise-mcp": "dist/index.js",
    "customaise": "dist/cli/index.js"
  },
  "files": [
    "dist/",
    "!dist/**/*.map",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:mcpb": "node mcpb/build.mjs",
    "mirror:plan": "node scripts/sync-public-mirror.mjs --json",
    "mirror:verify": "node scripts/sync-public-mirror.mjs --verify",
    "mirror:apply": "node scripts/sync-public-mirror.mjs --apply",
    "start": "node dist/index.js",
    "dev": "node --loader ts-node/esm src/index.ts",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test test-out/__tests__/*.test.js",
    "prepublishOnly": "npm run build && npm test",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "keywords": [
    "mcp",
    "customaise",
    "userscripts",
    "agentscripts",
    "webmcp",
    "hitl",
    "human-in-the-loop",
    "chrome-extension",
    "browser-automation",
    "model-context-protocol",
    "ai-tools",
    "cursor",
    "claude",
    "windsurf",
    "codex",
    "kiro",
    "antigravity",
    "cli",
    "command-line",
    "claude-desktop",
    "mcpb"
  ],
  "author": "CNDLE Studio LTD",
  "license": "MIT",
  "homepage": "https://customaise.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getcustomaise/customaise-mcp.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "ws": "^8.21.3",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "ts-node": "^10.9.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/getcustomaise/feedback/issues"
  },
  "bundleDependencies": true
}
